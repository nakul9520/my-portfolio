# ============================================================
# Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local — it's already excluded in .gitignore
#
# Usage:
#   cp .env.example .env.local
# ============================================================

# Google Gemini API Key
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Contact Form (Resend) ─────────────────────────────────────
# Used by POST /api/contact to send emails when someone submits
# the contact form on your portfolio.
#
# 1. Sign up free at https://resend.com (3,000 emails/month)
# 2. Go to API Keys → Create Key → copy the key below
RESEND_API_KEY=re_your_resend_api_key_here

# The Gmail address where contact form submissions are delivered.
# Use a dedicated/secondary Gmail — NOT your main inbox.
CONTACT_TO_EMAIL=your_contact_gmail@gmail.com
